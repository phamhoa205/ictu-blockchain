# ==========================================
# CẤU HÌNH MÔI TRƯỜNG BACKEND (RENDER / CLOUD)
# ==========================================

# Cổng máy chủ Express (Render tự động cấp PORT, mặc định local là 3000)
PORT=3000
NODE_ENV=production

# Khóa bí mật ký mã hóa JWT Token phiên đăng nhập
JWT_SECRET=ictu_reward_super_secret_jwt_key_2026

# ==========================================
# THÔNG TIN KẾT NỐI IBN BLOCKCHAIN GATEWAY (ICTU)
# ==========================================
IBN_BASE_URL=https://ibn.ictu.edu.vn
IBN_NETWORK=production

# Account ID và API Key do Ban Quản trị hệ thống IBN trường ICTU cấp
IBN_ACCOUNT_ID=6af7e9479ce30a3278af2087
IBN_API_KEY=your_ibn_api_key_here

# Địa chỉ Smart Contract trên mạng production (Chain ID: 2025, EVM London)
REWARD_TOKEN_ADDRESS=0x8fAAB493059E219255CeA538C4678Bd52C14788b
REWARD_MANAGER_ADDRESS=0x76B4E34AD84A0c64c1810dfed493a033fcD15436
